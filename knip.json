{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "scripts/*.ts",
    "test/setup-*.ts",
    "test/global-setup-*.ts",
    "test/vitest.config.mutation.ts"
  ],
  "ignore": ["lib/types/database.ts"],
  "ignoreDependencies": ["@stryker-mutator/api", "@stryker-mutator/command-runner"],
  "ignoreIssues": {
    "src/frontend/components/ui/**": ["exports", "types"]
  },
  "playwright": {
    "config": [],
    "entry": ["playwright.config.ts", "e2e/**/*.spec.ts", "e2e/support/global-setup.ts"]
  }
}
