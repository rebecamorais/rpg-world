{
  "name": "rpg-world",
  "version": "0.1.0",
  "author": "Rebeca Morais Cruz (Rebs Tech Studio)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "private": true,
  "scripts": {
    "infra": "npx tsx scripts/infra.ts",
    "icons": "npx tsx scripts/generate-game-icons.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:ui": "open http://localhost:54323 && open http://localhost:54324",
    "clean": "npm run infra clean",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config ./test/vitest.config.unit.ts",
    "test:integration": "vitest run --config ./test/vitest.config.integration.ts",
    "test:e2e": "playwright test",
    "test:visual": "VISUAL=1 playwright test",
    "knip": "knip",
    "test:mutation": "stryker run",
    "test:coverage": "vitest run --config ./test/vitest.config.unit.ts --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint",
    "format": "prettier --write .",
    "prepare": "husky",
    "postinstall": "npx tsx ./scripts/post-install-cleanup.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.11.1",
    "react-hook-form": "^7.90.0",
    "resend": "^6.32.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/game-icons": "^1.2.4",
    "@iconify/types": "^2.0.0",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "chalk": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sade": "^1.8.1",
    "server-only": "^0.0.1",
    "supabase": "2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "@swc/core": false,
    "esbuild": false,
    "unrs-resolver": false
  }
}
